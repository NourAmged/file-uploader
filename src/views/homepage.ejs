<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="style.css">
  <title>File Uploader</title>
</head>

<body>
  <%-include("navbar", locals.user)%>
  <%if(locals.user){%>
  <div class="sidebar">
    <button class="create-btn" onclick="document.querySelector('.create-menu').style.display = document.querySelector('.create-menu').style.display == 'none' ? 'flex' : 'none'">New</button>
    <form method="POST" action="/upload-file" class="create-menu" style="display: none;" enctype="multipart/form-data">
      <div class="upload-file">
        <input type="file" id="file" name="file" required />
        <button type="submit">Upload File</button>
      </div>
    </form>
    <p class="shared">Shared links</p>
  </div>
  </div>
  <%}%>
</body>

</html>