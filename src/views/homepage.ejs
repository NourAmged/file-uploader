<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>File Uploader</title>
</head>

<body>
  <%-include("navbar", locals.user)%>
  <%if(locals.user){%>
  <main>
    <div class="sidebar">
      <button class="create-btn">New</button>
      <div class="create-menu" style="display: none;">
        <form method="POST" action=<%= (locals.folderId) ? `/folder/${folderId}/create-folder` : "/create-folder"%>>
          <div class="create-folder">
            <input type="text" name="folder-name" id="folder-name" required placeholder="Folder Name">
            <button type="submit">Create Folder</button>
            <% if (locals.errors) { %>
            <ul class="error-list" style="padding:1rem">
              <% locals.errors.forEach(function(error) { %>
              <li><%= error.msg %></li>
              <% }); %>
            </ul>
            <% } %>
          </div>
        </form>

        <form method="POST" action=<%= (locals.folderId) ? `/folder/upload-file/${folderId}` : "/upload-file"%> enctype="multipart/form-data">
          <div class="upload-file">
            <input type="file" id="file" name="file" required />
            <button type="submit">Upload File</button>
            <% if (locals.errors) { %>
            <ul class="error-list" style="padding:1rem">
              <% locals.errors.forEach(function(error) { %>
              <li><%= error.msg %></li>
              <% }); %>
            </ul>
            <% } %>
          </div>
        </form>

      </div>
      <p class="shared">Shared links</p>
    </div>
    <div class="container">
      <h1 class="welcome-txt">Welcome to Storage</h1>
      <%if(locals.folders) {%>
      <div class="main-content-container">
        <h1>Folders</h1>
        <div class="folders">
          <%locals.folders.forEach((folder,idx) => {%>
          <div class="folder" onclick="window.location.href='/folder/<%=folder.id%>'">
            <p><%=folder.folder_name%></p>
            <img class="folder-btn" src="/dots.svg" alt="dots" />
            <div id="<%=idx%>" class="download-menu" style="display: none;">
              <p class="download-btn">Download</p>
              <p onclick="(function(e) { e.stopPropagation(); window.location.href='/folder/delete/<%=folder.id%>' })(event)" class="delete-btn">Delete</p>
            </div>
          </div>
          <%});%>
        </div>
      </div>
      <%}%>
  
      <%if(locals.files) {%>
      <div class="main-content-container">
        <h1>Files</h1>
        <div class="files">
          <%locals.files.forEach((file,idx) => {%>
          <div class="file">
            <p><%=file.file_name%></p>
            <img class="file-btn" src="/dots.svg" alt="dots" />
            <div id="<%=idx%>" class="download-menu" style="display: none;">
              <p onclick="window.location.href='/file/<%=file.id%>'" class="download-btn">Download</p>
              <p onclick="window.location.href='/file/delete/<%=file.id%>'" class="delete-btn">Delete</p>
            </div>
          </div>
          <%});%>
        </div>
      </div>

    </div>
    <%}%>
    <%}%>
  </main>
  <script src="/js/sidebar.js"></script>
  <script src="/js/fileFolderMenu.js"></script>
</body>

</html>