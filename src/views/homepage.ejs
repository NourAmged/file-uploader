<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="style.css">
  <title>File Uploader</title>
</head>

<body>
  <%-include("navbar", locals.user)%>
  <%if(locals.user){%>
  <main>
    <div class="sidebar">
      <button class="create-btn">New</button>
      <form method="POST" action="/upload-file" class="create-menu" style="display: none;" enctype="multipart/form-data">
        <div class="upload-file">
          <input type="file" id="file" name="file" required />
          <button type="submit">Upload File</button>
          <% if (locals.errors) { %>
          <ul class="error-list" style="padding:1rem">
            <% locals.errors.forEach(function(error) { %>
            <li><%= error.msg %></li>
            <% }); %>
          </ul>
          <% } %>
        </div>
      </form>
      <p class="shared">Shared links</p>
    </div>
    <%if(locals.files) {%>
    <div class="main-content-container">
      <h1 class="welcome-txt">Welcome to Storage</h1>
      <h1>Files</h1>
      <div class="files">
        <%locals.files.forEach((file,idx) => {%>
        <div class="file">
          <p><%=file.file_name%></p>
          <img class="file-btn" src="/dots.svg" alt="dots" />
          <div id="<%=idx%>" class="download-menu" style="display: none;">
            <p class="download-btn">Download</p>
            <p class="delete-btn">Delete</p>
          </div>
        </div>
        <%});%>
      </div>
    </div>
    <%}%>
    <%}%>
  </main>
  <script src="/js/sidebar.js"></script>
  <script src="/js/fileMenu.js"></script>
</body>

</html>