<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>File Uploader</title>
</head>
<body>
  <%-include("navbar", locals.user)%>
  <%if(locals.user){%>
  <main>
    <%-include("sidebar", locals.folderId, locals.errors)%>
    <div class="container">
      <h1 class="welcome-txt">Welcome to Storage</h1>
      <%if(locals.folders){%>
      <div class="main-content-container">
        <h1>Folders</h1>
        <%-include("folders", locals.folders)%>
      </div>
      <%}%>
      <%if(locals.files) {%>
      <div class="main-content-container">
        <h1>Files</h1>
        <%-include("files", locals.files)%>
      </div>
    </div>
    <%}%>
    <%}%>
  </main>
  <script src="/js/sidebar.js"></script>
  <script src="/js/fileFolderMenu.js"></script>
</body>

</html>